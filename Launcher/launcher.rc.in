/* Resource template for the DSPi Console launcher.
 * build.ps1 substitutes @VERSION_NUM@ / @VERSION_STR@ and compiles the result,
 * so the launcher always carries the version of the release it ships with. */

#include <windows.h>

1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    @VERSION_NUM@
PRODUCTVERSION @VERSION_NUM@
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0x0L
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Weeb Labs"
            VALUE "FileDescription",  "DSPi Console"
            VALUE "FileVersion",      "@VERSION_STR@"
            VALUE "InternalName",     "DSPiConsole"
            VALUE "LegalCopyright",   "Weeb Labs"
            VALUE "OriginalFilename", "DSPiConsole.exe"
            VALUE "ProductName",      "DSPi Console"
            VALUE "ProductVersion",   "@VERSION_STR@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
