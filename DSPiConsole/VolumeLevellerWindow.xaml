<Window
    x:Class="DSPiConsole.VolumeLevellerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Volume Leveller">

    <StackPanel Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20" Spacing="16">
                <!-- Header: icon + title on left, toggle on right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE994;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Volume Leveller" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Upward dynamic range compression"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="EnableToggle" Grid.Column="2" OnContent="On" OffContent="Off"
                                  Toggled="OnEnableToggled" MinWidth="0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                </Grid>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <TextBlock Text="PARAMETERS" FontSize="10" FontWeight="Bold"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Amount -->
                <StackPanel Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Amount" FontWeight="Medium" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="AmountTextBox" Width="50" TextChanged="OnAmountTextChanged"/>
                            <TextBlock Text="%" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="AmountSlider" Minimum="0" Maximum="100" StepFrequency="1"
                            ValueChanged="OnAmountSliderChanged"/>
                    <TextBlock Text="Compression strength. Higher values reduce dynamic range more aggressively."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Speed -->
                <StackPanel Spacing="6">
                    <TextBlock Text="Speed" FontWeight="Medium"/>
                    <StackPanel x:Name="SpeedPanel" Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="SpeedSlow" Content="Slow" GroupName="Speed"
                                     Checked="OnSpeedChanged"/>
                        <RadioButton x:Name="SpeedMedium" Content="Medium" GroupName="Speed"
                                     Checked="OnSpeedChanged"/>
                        <RadioButton x:Name="SpeedFast" Content="Fast" GroupName="Speed"
                                     Checked="OnSpeedChanged"/>
                    </StackPanel>
                    <TextBlock x:Name="SpeedDescription" FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Max Gain -->
                <StackPanel Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max Gain" FontWeight="Medium" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="MaxGainTextBox" Width="50" TextChanged="OnMaxGainTextChanged"/>
                            <TextBlock Text="dB" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="MaxGainSlider" Minimum="0" Maximum="35" StepFrequency="0.5"
                            ValueChanged="OnMaxGainSliderChanged"/>
                    <TextBlock Text="Maximum boost for quiet passages. Higher values risk amplifying noise."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Gate Threshold -->
                <StackPanel Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Gate Threshold" FontWeight="Medium" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <TextBox x:Name="GateTextBox" Width="50" TextChanged="OnGateTextChanged"/>
                            <TextBlock Text="dB" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                    <Slider x:Name="GateSlider" Minimum="-96" Maximum="0" StepFrequency="1"
                            ValueChanged="OnGateSliderChanged"/>
                    <TextBlock Text="Silence gate. Signals below this level are not boosted, preventing noise amplification."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Lookahead -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Lookahead" FontWeight="Medium"/>
                        <TextBlock Text="Adds 10ms latency. Improves transient handling."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="LookaheadToggle" Grid.Column="1" OnContent="On" OffContent="Off"
                                  Toggled="OnLookaheadToggled" MinWidth="0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                </Grid>
    </StackPanel>
</Window>
