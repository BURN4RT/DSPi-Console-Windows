<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DSPiConsole.PsychoacousticBassWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Psychoacoustic Bass">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20,20,0,20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="0,0,20,0">

                <!-- Header: title + enable -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE8D6;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Psychoacoustic Bass" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="Missing-fundamental bass enhancement for small speakers"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                    <ToggleSwitch x:Name="EnableToggle" Grid.Column="2" OnContent="On" OffContent="Off"
                                  Toggled="OnEnableToggled" MinWidth="0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                </Grid>

                <InfoBar x:Name="UnsupportedBar" IsOpen="False" IsClosable="False"
                         Severity="Informational" Title="Not available"
                         Message="This firmware does not include psychoacoustic bass (requires wire format V23 or newer)."/>

                <StackPanel x:Name="BodyPanel" Spacing="16">

                    <!-- Starting points -->
                    <DropDownButton x:Name="PresetButton" Content="Starting points" HorizontalAlignment="Left"/>

                    <!-- Per-output mask -->
                    <StackPanel x:Name="OutputMaskSection" Spacing="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Outputs" FontWeight="Medium" VerticalAlignment="Center"/>
                            <DropDownButton x:Name="OutputMaskPresets" Grid.Column="1" Content="Presets"
                                            Padding="8,2,8,2" FontSize="12"/>
                        </Grid>
                        <TextBlock Text="Enhance only the outputs feeding bass-limited speakers (exclude a real subwoofer)."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <StackPanel x:Name="OutputMaskHost" Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                    <!-- Cutoff -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Cutoff Frequency" FontWeight="Medium"/>
                        <TextBlock Text="Speaker low-frequency limit; harmonics are synthesized below this."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="CutoffSlider" Minimum="30" Maximum="300" StepFrequency="1"
                                    ValueChanged="OnCutoffChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="CutoffBox" Width="50" TextChanged="OnCutoffText"/>
                                <TextBlock Text="Hz" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Harmonics -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Harmonics" FontWeight="Medium"/>
                        <TextBlock Text="Level of the synthesized harmonic series."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="HarmonicsSlider" Minimum="-24" Maximum="12" StepFrequency="0.5"
                                    ValueChanged="OnHarmonicsChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="HarmonicsBox" Width="50" TextChanged="OnHarmonicsText"/>
                                <TextBlock Text="dB" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Drive -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Drive" FontWeight="Medium"/>
                        <TextBlock Text="Odd-harmonic clipper drive."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="DriveSlider" Minimum="0" Maximum="18" StepFrequency="0.5"
                                    ValueChanged="OnDriveChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="DriveBox" Width="50" TextChanged="OnDriveText"/>
                                <TextBlock Text="dB" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Character -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Character" FontWeight="Medium"/>
                        <TextBlock Text="Even ↔ odd harmonic blend (warm ↔ aggressive)."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="CharacterSlider" Minimum="0" Maximum="100" StepFrequency="1"
                                    ValueChanged="OnCharacterChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="CharacterBox" Width="50" TextChanged="OnCharacterText"/>
                                <TextBlock Text="%" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Original bass -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Original Bass" FontWeight="Medium"/>
                        <TextBlock Text="Level of the original low band kept alongside the harmonics (lower protects small drivers)."
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="OriginalSlider" Minimum="-60" Maximum="0" StepFrequency="1"
                                    ValueChanged="OnOriginalChanged"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                                <TextBox x:Name="OriginalBox" Width="50" TextChanged="OnOriginalText"/>
                                <TextBlock Text="dB" VerticalAlignment="Center"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
