<Window
    x:Class="DSPiConsole.StatsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stats for nerbs">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">
                <TextBlock Text="Stats for nerbs" FontSize="20" FontWeight="SemiBold"/>

                <!-- Device Info -->
                <StackPanel Spacing="4">
                    <TextBlock Text="DEVICE INFO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Platform" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PlatformText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Firmware" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="FirmwareVersionText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="Serial" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SerialText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- System Info -->
                <StackPanel Spacing="4">
                    <TextBlock Text="SYSTEM INFO" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Clock" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="ClockText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Voltage" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="VoltageText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="Sample Rate" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SampleRateText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="3" Text="Temperature" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="TempText" Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- PDM Stats -->
                <StackPanel Spacing="4">
                    <TextBlock Text="PDM STATS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Ring Overruns" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmRingOverText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Ring Underruns" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmRingUnderText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="DMA Overruns" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmDmaOverText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="3" Text="DMA Underruns" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmDmaUnderText" Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- SPDIF Stats (existing overrun/underrun counters) -->
                <StackPanel Spacing="4">
                    <TextBlock Text="SPDIF STATS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Overruns" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SpdifOverText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Underruns" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="SpdifUnderText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- USB Audio Ring -->
                <StackPanel Spacing="4">
                    <TextBlock Text="USB AUDIO RING" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Overruns" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="UsbRingOverText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- SPDIF Buffer Fill Levels -->
                <StackPanel Spacing="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SPDIF BUFFER LEVELS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                        <Button x:Name="ResetWatermarksButton" Grid.Column="1" Content="Reset Watermarks"
                                FontSize="11" Padding="8,4"/>
                    </Grid>

                    <!-- SPDIF 1 -->
                    <TextBlock Text="SPDIF 1" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Fill" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif1FillText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Watermarks" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif1WatermarksText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="Queued" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif1QueuedText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>

                    <!-- SPDIF 2 -->
                    <TextBlock Text="SPDIF 2" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Grid ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Fill" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif2FillText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Watermarks" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif2WatermarksText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="Queued" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif2QueuedText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>

                    <!-- SPDIF 3 -->
                    <TextBlock x:Name="Spdif3Header" Text="SPDIF 3" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Grid x:Name="Spdif3Grid" ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Fill" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif3FillText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Watermarks" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif3WatermarksText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="Queued" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif3QueuedText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>

                    <!-- SPDIF 4 -->
                    <TextBlock x:Name="Spdif4Header" Text="SPDIF 4" FontSize="10" FontWeight="SemiBold" Margin="0,4,0,0"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                    <Grid x:Name="Spdif4Grid" ColumnSpacing="12" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Fill" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif4FillText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="Watermarks" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif4WatermarksText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="Queued" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="Spdif4QueuedText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- PDM Buffer Fill Levels -->
                <StackPanel Spacing="4">
                    <TextBlock Text="PDM BUFFER LEVELS" FontSize="11" FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                    <Grid ColumnSpacing="12" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="DMA Fill" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmDmaFillText" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="1" Text="DMA Watermarks" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmDmaWatermarksText" Grid.Row="1" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="2" Text="Ring Fill" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmRingFillText" Grid.Row="2" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>

                        <TextBlock Grid.Row="3" Text="Ring Watermarks" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock x:Name="PdmRingWatermarksText" Grid.Row="3" Grid.Column="1" FontFamily="Cascadia Code, Consolas"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
