<ContentDialog
    x:Class="DSPiConsole.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Settings"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <TabView x:Name="SettingsTabs" MinWidth="460" Height="400"
             IsAddTabButtonVisible="False"
             CanDragTabs="False"
             CanReorderTabs="False"
             TabWidthMode="SizeToContent">
        <TabView.TabItems>
            <TabViewItem Header="General" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="12,16,12,0">
                        <TextBlock Text="No settings yet." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Appearance" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="12,16,12,0">
                        <TextBlock Text="No settings yet." FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Graphing" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="12,16,12,0">
                        <ToggleSwitch x:Name="GlowToggle" Header="Graph Glow Effect" OnContent="On" OffContent="Off"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Line Width" FontSize="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="LineWidthSlider" Minimum="1" Maximum="4" StepFrequency="0.5"/>
                                <TextBlock Grid.Column="1" x:Name="LineWidthText" FontFamily="Cascadia Code, Consolas"
                                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Width="30"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Animation Speed" FontSize="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="AnimSpeedSlider" Minimum="0.05" Maximum="0.5" StepFrequency="0.05"/>
                                <TextBlock Grid.Column="1" x:Name="AnimSpeedText" FontFamily="Cascadia Code, Consolas"
                                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Width="30"/>
                            </Grid>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Vertical Range" FontSize="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DbRangeSlider" Minimum="10" Maximum="100" StepFrequency="5"/>
                                <TextBlock Grid.Column="1" x:Name="DbRangeText" FontFamily="Cascadia Code, Consolas"
                                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Width="50"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Center Offset" FontSize="12"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="DbCenterSlider" Minimum="-40" Maximum="20" StepFrequency="1"/>
                                <TextBlock Grid.Column="1" x:Name="DbCenterText" FontFamily="Cascadia Code, Consolas"
                                           FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" Width="100"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Min Frequency" FontSize="12"/>
                            <ComboBox x:Name="MinFreqCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="10 Hz" Tag="10"/>
                                <ComboBoxItem Content="15 Hz" Tag="15"/>
                                <ComboBoxItem Content="20 Hz" Tag="20"/>
                                <ComboBoxItem Content="50 Hz" Tag="50"/>
                                <ComboBoxItem Content="100 Hz" Tag="100"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Max Frequency" FontSize="12"/>
                            <ComboBox x:Name="MaxFreqCombo" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="5 kHz" Tag="5000"/>
                                <ComboBoxItem Content="10 kHz" Tag="10000"/>
                                <ComboBoxItem Content="20 kHz" Tag="20000"/>
                            </ComboBox>
                        </StackPanel>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4,0,4"/>

                        <ToggleSwitch x:Name="FreqGridToggle" Header="Show Frequency Grid" OnContent="On" OffContent="Off"/>
                        <ToggleSwitch x:Name="FreqLabelsToggle" Header="Show Frequency Labels" OnContent="On" OffContent="Off"/>
                        <ToggleSwitch x:Name="DbGridToggle" Header="Show dB Grid" OnContent="On" OffContent="Off"/>
                        <ToggleSwitch x:Name="DbLabelsToggle" Header="Show dB Labels" OnContent="On" OffContent="Off"/>
                        <ToggleSwitch x:Name="DbUnitsToggle" Header="Show dB Units on Axis" OnContent="On" OffContent="Off"/>
                        <ToggleSwitch x:Name="DottedInactiveToggle" Header="Dotted Inactive Channels" OnContent="On" OffContent="Off"/>
                        <ToggleSwitch x:Name="PopoutFollowsChannelToggle" Header="Pop-out Follows Selected Channel" OnContent="On" OffContent="Off"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Presets" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PresetsPanel" Spacing="16" Padding="12,16,12,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Startup Mode" FontSize="12"/>
                            <ComboBox x:Name="StartupModeCombo" HorizontalAlignment="Stretch"
                                      SelectionChanged="OnStartupModeChanged">
                                <ComboBoxItem Content="Default Preset" Tag="0"/>
                                <ComboBoxItem Content="Last Used" Tag="1"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="Default Startup Preset" FontSize="12"/>
                            <ComboBox x:Name="DefaultPresetCombo" HorizontalAlignment="Stretch"
                                      IsEnabled="False"
                                      SelectionChanged="OnDefaultPresetChanged"/>
                        </StackPanel>

                        <ToggleSwitch x:Name="IncludePinsToggle" Header="Include Pin Assignments in Presets"
                                      OnContent="On" OffContent="Off"
                                      Toggled="OnIncludePinsToggled"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Hardware" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="HardwarePanel" Spacing="12" Padding="12,16,12,0"/>
                </ScrollViewer>
            </TabViewItem>

            <TabViewItem Header="Advanced" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="16" Padding="12,16,12,0">
                        <ToggleSwitch x:Name="DebugToggle" Header="Show Debug Info" OnContent="On" OffContent="Off"/>
                    </StackPanel>
                </ScrollViewer>
            </TabViewItem>
        </TabView.TabItems>
    </TabView>
</ContentDialog>
