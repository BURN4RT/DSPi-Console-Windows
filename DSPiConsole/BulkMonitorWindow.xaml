<Window
    x:Class="DSPiConsole.BulkMonitorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Bulk Endpoint Monitor">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="PauseButton" Content="Pause" Width="80"/>
                <Button x:Name="ClearButton" Content="Clear" Width="80"/>
                <CheckBox x:Name="AutoScrollCheck" Content="Auto-scroll" IsChecked="True"
                          VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowIdleCheck" Content="Show IDLE" IsChecked="False"
                          VerticalAlignment="Center"/>
                <CheckBox x:Name="ShowHexCheck" Content="Show raw bytes" IsChecked="False"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Log -->
        <ScrollViewer x:Name="LogScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto">
            <TextBlock x:Name="LogText"
                       FontFamily="Cascadia Code, Consolas"
                       FontSize="11"
                       IsTextSelectionEnabled="True"
                       TextWrapping="NoWrap"
                       Padding="12,8"/>
        </ScrollViewer>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="12,4" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" FontSize="11"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="CountText" Grid.Column="1" FontSize="11"
                           FontFamily="Cascadia Code, Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
