<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareClockingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        Clocking. One page for the question "who owns the clock, and at what rate"
        — previously split across three pages, which made it hard to see that the
        sample rate only means anything while the DSPi is a master.

          • Sample rate (V12+): the rate the DSPi generates. Greyed out while the
            I2S clock is slaved, because then an external master owns it and the
            firmware auto-detects what arrives.
          • I2S clock mode (V21+): master generates BCK/LRCK, slave syncs to an
            external master. The GPIOs those clocks land on stay on I²S
            Configuration — this page is about the clock domain, not the wiring.
          • ADAT input clock mode (V24+): same choice for the optical link. Master
            with the ADAT output off leaves the far end free-running, hence the
            warning at the bottom.

        The three sit together as one group, because the rate only means anything
        in light of the two mode cards next to it. Each mode card carries its own
        lock indicator beside the picker (slave state is only ever readable, never
        settable) and hides when its firmware support is absent.
    -->
    <StackPanel Spacing="4">

        <controls:SettingsCard x:Name="RateCard" Header="Default Sample Rate"
                               Description="Active when DSPi is the I2S or ADAT clock master">
            <ComboBox x:Name="RateCombo" MinWidth="140" SelectionChanged="OnRateChanged">
                <ComboBoxItem Content="44.1 kHz" Tag="44100"/>
                <ComboBoxItem Content="48 kHz" Tag="48000"/>
                <ComboBoxItem Content="96 kHz" Tag="96000"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="I2sClockCard" Header="I2S Clock Mode"
                               Description="Master: the DSPi generates BCK and LRCK at the sample rate above.&#x0A;Slave: the DSPi syncs to an external master's BCK and LRCK, and the rate is detected from them.&#x0A;Which GPIOs carry the clocks is set on the I²S Configuration page.">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="I2sLockPill" FontSize="11"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <ComboBox x:Name="I2sClockCombo" MinWidth="120" SelectionChanged="OnI2sClockModeChanged">
                    <ComboBoxItem Content="Master" Tag="0"/>
                    <ComboBoxItem Content="Slave" Tag="1"/>
                </ComboBox>
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="AdatClockCard" Header="ADAT Clock Mode"
                               Description="Master: the DSPi sets the rate and the far end follows the lightpipe it sends. Use this when the ADAT output feeds an outboard DAC/ADC whose return comes back in.&#x0A;Slave: the DSPi locks to the incoming lightpipe from an external ADAT master, which then owns the rate (44.1/48 kHz, auto-detected).">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="AdatLockPill" FontSize="11"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <ComboBox x:Name="AdatClockCombo" MinWidth="120" SelectionChanged="OnAdatClockModeChanged">
                    <ComboBoxItem Content="Master" Tag="0"/>
                    <ComboBoxItem Content="Slave" Tag="1"/>
                </ComboBox>
            </StackPanel>
        </controls:SettingsCard>

        <InfoBar x:Name="FreeRunBar" IsOpen="False" IsClosable="False"
                 Severity="Warning" Title="ADAT clock is free-running" Margin="0,4,0,0"
                 Message="The ADAT input is set to Master but the ADAT output is off, so nothing external is locked to the DSPi's clock. The source drifts against it and you will hear periodic pops and clicks. Turn the ADAT output on and connect its lightpipe to the source to close the loop.">
            <InfoBar.ActionButton>
                <Button Content="Turn the ADAT output on" Click="OnEnableAdatOutputClick"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
