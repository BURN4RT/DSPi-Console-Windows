<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareAdatInputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        ADAT Input page (RP2350-only). A selectable 8-channel optical input source:
        one TOSLINK receiver feeds 8 channels of 24-bit audio into input channels
        0..7. Set the RX pin before enabling. Master clock: the DSPi owns the rate
        (set in I2S Configuration). Slave: an external ADAT master owns the clock
        and the rate is auto-detected (44.1/48 kHz). Registered only on firmware
        that reports ADAT input support.
    -->
    <StackPanel Spacing="4">

        <controls:SettingsCard Header="Enable"
                               Description="Use an 8-channel optical ADAT lightpipe as the input source for all.">
            <ToggleSwitch x:Name="EnableToggle" OnContent="On" OffContent="Off"
                          Toggled="OnEnableToggled"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="PinCard" Header="Serial Data"
                               Description="GPIO receiving the ADAT optical input.">
            <ComboBox x:Name="PinCombo" MinWidth="160" SelectionChanged="OnPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Clock Mode"
                               Description="Master: Use with ADAT Output to an outboard DAC/ADC with its return connected to ADAT Input.&#x0A;Slave: Sync DSPi to an external ADAT master device.">
            <ComboBox x:Name="ClockModeCombo" MinWidth="120" SelectionChanged="OnClockModeChanged">
                <ComboBoxItem Content="Master" Tag="0"/>
                <ComboBoxItem Content="Slave" Tag="1"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="LockCard" Header="Lock Status" Visibility="Collapsed">
            <TextBlock x:Name="LockText" FontSize="12" VerticalAlignment="Center"/>
        </controls:SettingsCard>

        <InfoBar x:Name="FreeRunBar" IsOpen="False" IsClosable="False"
                 Severity="Warning" Title="Clock is free-running" Margin="0,4,0,0"
                 Message="ADAT input is in Master mode but the ADAT output is off, so no device is locked to the DSPi's clock. Periodic pops and clicks will be heard. Enable the ADAT output and connect its return to close the clock loop.">
            <InfoBar.ActionButton>
                <Button Content="Enable ADAT Output" Click="OnEnableAdatOutputClick"/>
            </InfoBar.ActionButton>
        </InfoBar>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
