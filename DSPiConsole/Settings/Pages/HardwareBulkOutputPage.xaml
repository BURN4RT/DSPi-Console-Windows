<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareBulkOutputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        ADAT Output page. RP2350-only optical "bulk" tap that streams all 8
        output channels as one ADAT lightpipe (44.1/48 kHz, 24-bit) from a single
        data GPIO, concurrent with the SPDIF/I2S slots and PDM. Only enable + data
        pin are configurable — the channel mapping is fixed (ADAT slot N = output N)
        and S/MUX is not exposed. Registered only on firmware that reports ADAT.
    -->
    <StackPanel Spacing="4">

        <controls:SettingsCard Header="Enable"
                               Description="Stream all 8 output channels as one optical ADAT lightpipe (44.1/48 kHz, 24-bit).">
            <ToggleSwitch x:Name="EnableToggle" OnContent="On" OffContent="Off"
                          Toggled="OnEnableToggled"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="PinCard" Header="Serial Data"
                               Description="GPIO driving the ADAT optical output.">
            <ComboBox x:Name="PinCombo" MinWidth="140" SelectionChanged="OnAdatPinChanged"/>
        </controls:SettingsCard>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
