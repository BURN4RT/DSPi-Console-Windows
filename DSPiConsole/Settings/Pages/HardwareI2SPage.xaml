<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareI2SPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        I2S. The whole interface on one page, because the clocks are shared between
        the input and the output paths — splitting them across two pages meant the
        BCK pin lived somewhere the input page had to send you to.

        Clock:
          • Clock mode (V21+): master generates BCK/LRCK, slave syncs to an
            external master. Carries its own lock indicator (slave state is only
            ever readable, never settable). The rate the DSPi generates as master
            is shared with ADAT and lives on Hardware › Master Clock.
          • BCK pin: only changeable when NO output slot is I²S — the firmware
            refuses to re-route the clock while it's actively driving. LRCK
            follows at BCK + 1.
          • Clock pins (V21+): Unified reuses one BCK/LRCK pair for both roles,
            Split gives the slave role its own pair. The slave pair's card only
            exists in Split, so it hides in Unified.

        Input (V12+, hidden otherwise):
          • Channels: input channel count (2/4/6/8) on RP2350; hidden on RP2040
            (stereo only). N channels use N/2 stereo pairs.
          • One "Serial Data" GPIO card per active stereo pair. They share the bit
            clock above.

        Every pin picker labels GPIOs already claimed elsewhere with their owner
        and disables them. The BCK picker additionally greys out in slave mode,
        where an external master drives the line — the rest stay editable, as they
        always have. The section headings and the rule between them only earn
        their place when the input half is present.
    -->
    <StackPanel Spacing="4">

        <!-- ── Clock ────────────────────────────────────────────────────── -->
        <TextBlock x:Name="ClockHeading" Text="Clock" FontWeight="SemiBold"
                   Margin="0,4,0,2" Visibility="Collapsed"/>

        <controls:SettingsCard x:Name="ClockModeCard" Header="Clock Mode"
                               Description="Master: the DSPi generates BCK and LRCK at the sample rate set on the Master Clock page.&#x0A;Slave: the DSPi syncs to an external master's BCK and LRCK, and the rate is detected from them."
                               Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock x:Name="ClockLockPill" FontSize="11"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <ComboBox x:Name="ClockModeCombo" MinWidth="120" SelectionChanged="OnClockModeChanged">
                    <ComboBoxItem Content="Master" Tag="0"/>
                    <ComboBoxItem Content="Slave" Tag="1"/>
                </ComboBox>
            </StackPanel>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="BckPinCard" Header="BCK pin">
            <ComboBox x:Name="BckPinCombo" MinWidth="140"
                      SelectionChanged="OnBckPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="ClockPinsCard" Header="Clock Pins"
                               Description="Unified: Master and Slave modes share one BCK/LRCLK pair.&#x0A;Split: a separate pin pair for Slave mode."
                               Visibility="Collapsed">
            <ComboBox x:Name="ClockPinsCombo" MinWidth="120" SelectionChanged="OnClockPinsChanged">
                <ComboBoxItem Content="Unified" Tag="0"/>
                <ComboBoxItem Content="Split" Tag="1"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="SlaveBckCard" Header="Slave BCK pin"
                               Description="GPIO for the slave-mode bit clock; LRCLK = BCK + 1. Editable only in Split mode."
                               Visibility="Collapsed">
            <ComboBox x:Name="SlaveBckCombo" MinWidth="140" SelectionChanged="OnSlaveBckChanged"/>
        </controls:SettingsCard>

        <Border x:Name="SectionDivider" Height="1" Margin="0,10,0,6"
                Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                Visibility="Collapsed"/>

        <!-- ── Input ────────────────────────────────────────────────────── -->
        <TextBlock x:Name="InputHeading" Text="Input" FontWeight="SemiBold"
                   Margin="0,4,0,2" Visibility="Collapsed"/>

        <controls:SettingsCard x:Name="ChannelsCard" Header="Channels"
                               Description="Number of input channels. Each stereo pair uses its own serial-data GPIO sharing one bit clock."
                               Visibility="Collapsed">
            <ComboBox x:Name="ChannelsCombo" MinWidth="80" SelectionChanged="OnChannelsChanged">
                <ComboBoxItem Content="2" Tag="2"/>
                <ComboBoxItem Content="4" Tag="4"/>
                <ComboBoxItem Content="6" Tag="6"/>
                <ComboBoxItem Content="8" Tag="8"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard0" Header="Serial Data"
                               Description="GPIO data pin for input channels 1-2."
                               Visibility="Collapsed">
            <ComboBox x:Name="RxPinCombo0" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard1" Header="Serial Data 2"
                               Description="GPIO data pin for input channels 3-4."
                               Visibility="Collapsed">
            <ComboBox x:Name="RxPinCombo1" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard2" Header="Serial Data 3"
                               Description="GPIO data pin for input channels 5-6."
                               Visibility="Collapsed">
            <ComboBox x:Name="RxPinCombo2" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard3" Header="Serial Data 4"
                               Description="GPIO data pin for input channels 7-8."
                               Visibility="Collapsed">
            <ComboBox x:Name="RxPinCombo3" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
