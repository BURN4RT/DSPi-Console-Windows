<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareI2SPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        Four I²S clock-config cards. Their interrelation:
          • BCK pin: only changeable when NO output slot is I²S (firmware
            refuses to re-route the clock while it's actively driving).
          • MCK pin: only changeable when MCK is OFF (same reason).
          • MCK multiplier: 256× is unavailable at sample rates ≥ 96 kHz
            (the firmware's PLL constraint).

        Enable state of each control reflects these in real time; the
        Description slot carries the explanation when something is locked.
    -->
    <StackPanel Spacing="4">

        <controls:SettingsCard x:Name="MckEnableCard"
                                Header="Master Clock (MCK)"
                                Description="Clock reference for external DACs.">
                        <ToggleSwitch x:Name="MckToggle" OnContent="On" OffContent="Off"
                          Toggled="OnMckToggled"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="MckPinCard"
                                Header="MCK pin"
                                Description="Turn MCK off to change its pin.">
                        <ComboBox x:Name="MckPinCombo" MinWidth="140"
                      SelectionChanged="OnMckPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="MckMultiplierCard"
                                Header="MCK multiplier">
                        <ComboBox x:Name="MckMultiplierCombo" MinWidth="100"
                      SelectionChanged="OnMckMultiplierChanged">
                <ComboBoxItem Content="128×" Tag="128"/>
                <ComboBoxItem Content="256×" Tag="256"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="BckPinCard"
                                Header="BCK pin">
                        <ComboBox x:Name="BckPinCombo" MinWidth="140"
                      SelectionChanged="OnBckPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="ClockModeCard" Header="Clock Mode"
                               Description="Master: Generate BCK/LRCK.&#x0A;Slave: Sync to an external master."
                               Visibility="Collapsed">
            <ComboBox x:Name="ClockModeCombo" MinWidth="120" SelectionChanged="OnClockModeChanged">
                <ComboBoxItem Content="Master" Tag="0"/>
                <ComboBoxItem Content="Slave" Tag="1"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="ClockLockCard" Header="Clock Lock" Visibility="Collapsed">
            <TextBlock x:Name="ClockLockText" FontSize="12" VerticalAlignment="Center"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="ClockPinsCard" Header="Clock Pins"
                               Description="Unified: Master and Slave modes share one BCK/LRCLK pair.&#x0A;Split: a separate pin pair for Slave mode."
                               Visibility="Collapsed">
            <ComboBox x:Name="ClockPinsCombo" MinWidth="120" SelectionChanged="OnClockPinsChanged">
                <ComboBoxItem Content="Unified" Tag="0"/>
                <ComboBoxItem Content="Split" Tag="1"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="SlaveBckCard" Header="Slave BCK pin"
                               Description="GPIO for the slave-mode bit clock; LRCLK = BCK + 1. Editable only in Split mode."
                               Visibility="Collapsed">
            <ComboBox x:Name="SlaveBckCombo" MinWidth="140" SelectionChanged="OnSlaveBckChanged"/>
        </controls:SettingsCard>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
