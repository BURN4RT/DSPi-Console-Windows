<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareI2SInputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        I2S Input page.
          - Channels: input channel count (2/4/6/8) on RP2350; hidden on RP2040
            (stereo only). N channels use N/2 stereo pairs.
          - One "Serial Data" GPIO pin card per active stereo pair.
        The BCK/LRCK/MCK clock pins are shared with the I2S *output* path and are
        configured on the Hardware › I2S page; the sample rate and the master/slave
        choice are on Hardware › Clocking. Registered on V12+ firmware only.
    -->
    <StackPanel Spacing="4">

        <controls:SettingsCard x:Name="ChannelsCard" Header="Channels"
                               Description="Number of input channels. Each stereo pair uses its own serial-data GPIO sharing one bit clock."
                               Visibility="Collapsed">
            <ComboBox x:Name="ChannelsCombo" MinWidth="80" SelectionChanged="OnChannelsChanged">
                <ComboBoxItem Content="2" Tag="2"/>
                <ComboBoxItem Content="4" Tag="4"/>
                <ComboBoxItem Content="6" Tag="6"/>
                <ComboBoxItem Content="8" Tag="8"/>
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard0" Header="Serial Data"
                               Description="GPIO data pin for input channels 1-2.">
            <ComboBox x:Name="RxPinCombo0" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard1" Header="Serial Data 2"
                               Description="GPIO data pin for input channels 3-4."
                               Visibility="Collapsed">
            <ComboBox x:Name="RxPinCombo1" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard2" Header="Serial Data 3"
                               Description="GPIO data pin for input channels 5-6."
                               Visibility="Collapsed">
            <ComboBox x:Name="RxPinCombo2" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard x:Name="RxPinCard3" Header="Serial Data 4"
                               Description="GPIO data pin for input channels 7-8."
                               Visibility="Collapsed">
            <ComboBox x:Name="RxPinCombo3" MinWidth="140" SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
