<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.HardwareI2SInputPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        I2S Input page. Two cards:
          1. RX data pin — the GPIO carrying the external I2S data line.
             Conflict-aware (greys out pins claimed by outputs, clocks, SPDIF RX).
          2. Sample rate — DSPi is the I2S clock master, so the host selects the
             rate the device drives (44.1 / 48 / 96 kHz). Applied when I2S is the
             active source; stored as a preference otherwise.
        The BCK/LRCK/MCK clock pins are shared with the I2S *output* path and are
        configured on the Hardware › I2S page. Page only registered on V12+
        firmware that exposes I2S input (see IsAvailable).
    -->
    <StackPanel Spacing="4">

        <controls:SettingsCard Header="RX data pin"
                               Description="GPIO pin for the I2S input data line (default 4). The BCK/LRCK clock pins are shared with I2S output — set them on the I2S page.">
            <ComboBox x:Name="I2sRxPinCombo" MinWidth="140"
                      SelectionChanged="OnI2sRxPinChanged"/>
        </controls:SettingsCard>

        <controls:SettingsCard Header="Sample rate"
                               Description="DSPi is the I2S clock master, so it drives the sample rate. The external source must slave to this clock.">
            <ComboBox x:Name="I2sRateCombo" MinWidth="140"
                      SelectionChanged="OnI2sRateChanged">
                <ComboBoxItem Content="44.1 kHz" Tag="44100"/>
                <ComboBoxItem Content="48 kHz" Tag="48000"/>
                <ComboBoxItem Content="96 kHz" Tag="96000"/>
            </ComboBox>
        </controls:SettingsCard>

        <TextBlock x:Name="StatusText"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </StackPanel>
</settings:SettingsModule>
