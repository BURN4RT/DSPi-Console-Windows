<?xml version="1.0" encoding="utf-8"?>
<settings:SettingsModule
    x:Class="DSPiConsole.Settings.Pages.PresetsInclusionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:DSPiConsole.Settings"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls">

    <!--
        Output config persistence mode (REQ_SET_OUTPUT_CONFIG_MODE, 0x98).
        Governs whether the physical IO block (output pins/types, I2S MCK/BCK,
        SPDIF RX pin) travels with each preset or stays device-global.
    -->
    <StackPanel Spacing="4">

        <Border x:Name="UnsupportedNotice"
                Padding="12,8"
                Background="{ThemeResource SubtleFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Visibility="Collapsed">
            <TextBlock Text="Presets are not supported by this firmware version."
                       FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap"/>
        </Border>

        <controls:SettingsCard x:Name="OutputConfigModeCard"
                                Header="Output configuration"
                                Description="How the physical IO config (output pins, output types, I2S MCK/BCK, S/PDIF RX pin) is persisted. With preset: each preset carries its own IO. Independent: IO is device-global and unchanged by preset loads; explicitly save with File &#x2192; Save Output Config.">
            <ComboBox x:Name="OutputConfigModeCombo"
                      MinWidth="160"
                      SelectionChanged="OnOutputConfigModeChanged">
                <ComboBoxItem Content="With preset"  Tag="1"/>
                <ComboBoxItem Content="Independent"  Tag="0"/>
            </ComboBox>
        </controls:SettingsCard>
    </StackPanel>
</settings:SettingsModule>
