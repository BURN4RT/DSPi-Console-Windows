<Window
    x:Class="DSPiConsole.CrossfeedWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Crossfeed">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" Padding="20,20,0,20">
        <ScrollViewer x:Name="MainScrollViewer"
                      VerticalScrollBarVisibility="Auto"
                      PointerEntered="OnScrollViewerPointerEntered"
                      PointerExited="OnScrollViewerPointerExited"
                      ViewChanged="OnScrollViewerViewChanged">
            <StackPanel Spacing="16" Padding="0,0,20,0">
                <!-- Header: title on left, toggle on right -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <FontIcon Glyph="&#xE7F6;" FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Crossfeed" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="BS2B binaural processing for natural sound"
                                   FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <ToggleSwitch x:Name="EnableToggle" Grid.Column="2" OnContent="On" OffContent="Off"
                                  Toggled="OnEnableToggled" MinWidth="0" HorizontalAlignment="Right"
                                  VerticalAlignment="Center"/>
                </Grid>

                <!-- Frequency Response Graph with axes -->
                <Border CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        Padding="0">
                    <Grid Height="180">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="20"/>
                        </Grid.RowDefinitions>

                        <!-- Y-axis labels -->
                        <Canvas x:Name="YAxisCanvas" Grid.Column="0" Grid.Row="0"/>

                        <!-- Plot area -->
                        <Canvas x:Name="CurveCanvas" Grid.Column="1" Grid.Row="0" Margin="0,8,8,0"/>

                        <!-- X-axis labels -->
                        <Canvas x:Name="XAxisCanvas" Grid.Column="1" Grid.Row="1" Margin="0,0,8,0"/>
                    </Grid>
                </Border>

                <!-- Per-output-pair mask (firmware V20+) -->
                <StackPanel x:Name="OutputPairSection" Spacing="6" Visibility="Collapsed">
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output Pairs" FontWeight="Medium" VerticalAlignment="Center"/>
                        <DropDownButton x:Name="OutputPairPresets" Grid.Column="1" Content="Presets"
                                        Padding="8,2,8,2" FontSize="12"/>
                    </Grid>
                    <TextBlock Text="Crossfeed only the stereo pairs feeding headphones. Other pairs stay bit-accurate; the mono sub is never crossfed."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <StackPanel x:Name="OutputPairHost" Margin="0,4,0,0"/>
                </StackPanel>

                <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>

                <!-- Preset selection -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Preset" FontWeight="Medium"/>
                    <TextBlock Text="Quick configurations for different listening preferences."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <RadioButtons x:Name="PresetRadio" SelectionChanged="OnPresetChanged">
                        <RadioButton Content="Default (700 Hz / 4.5 dB)" Tag="0"/>
                        <RadioButton Content="Chu Moy (700 Hz / 6.0 dB)" Tag="1"/>
                        <RadioButton Content="Jan Meier (650 Hz / 9.5 dB)" Tag="2"/>
                        <RadioButton Content="Custom" Tag="3"/>
                    </RadioButtons>
                </StackPanel>

                <!-- Cutoff Frequency -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Cutoff Frequency" FontWeight="Medium"/>
                    <TextBlock Text="Lower frequencies produce a wider spatial effect."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FreqSlider" Minimum="500" Maximum="2000" StepFrequency="10"
                                ValueChanged="OnFreqSliderChanged"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                            <TextBox x:Name="FreqTextBox" Width="50" TextChanged="OnFreqTextChanged"/>
                            <TextBlock Text="Hz" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Feed Level -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Feed Level" FontWeight="Medium"/>
                    <TextBlock Text="Amount of opposite channel signal mixed in."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Slider x:Name="FeedSlider" Minimum="0" Maximum="15" StepFrequency="0.1"
                                ValueChanged="OnFeedSliderChanged"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0">
                            <TextBox x:Name="FeedTextBox" Width="50" TextChanged="OnFeedTextChanged"/>
                            <TextBlock Text="dB" VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Interaural Time Delay -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Interaural Time Delay" FontWeight="Medium"/>
                    <TextBlock Text="Simulates natural ~220 μs path difference between ears."
                               FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <ToggleSwitch x:Name="ItdToggle" OnContent="Enabled" OffContent="Disabled"
                                  Toggled="OnItdToggled" MinWidth="0"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
